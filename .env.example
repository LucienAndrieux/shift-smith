# Copy to `.env` at the repository root. Both `pnpm dev` and the scripts read it.

# --- Database -----------------------------------------------------------------
# postgres.js connection string. The dev value matches docker-compose.yml.
DATABASE_URL=postgres://planner:planner@localhost:5432/planner

# --- Visitor sessions (Better Auth, anonymous guests) ------------------------------
# Random secret, at least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# --- Contact form (start page) ------------------------------------------------
# Where the messages of the contact form are sent. With Gmail: SMTP_HOST=
# smtp.gmail.com, SMTP_PORT=465, SMTP_USER = the Gmail address, SMTP_PASSWORD = an
# app password, SMTP_FROM = "ShiftSmith <the Gmail address>". Leave SMTP_HOST
# empty in development: the messages are then printed to the console.
CONTACT_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ShiftSmith <no-reply@example.com>"

# "Schedule a meeting" hides the slots that are busy in this Google Calendar.
# Google Cloud: create a service account and a JSON key, enable the Google
# Calendar API; then share the calendar with the service account's email with
# "See only free/busy (hide details)". GOOGLE_SERVICE_ACCOUNT_KEY is the key's
# "private_key" value, on one line with \n escapes, in double quotes. Leave
# empty to show every offered slot.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- LLM (natural-language constraints) ----------------------------------------------
# Any OpenAI-compatible chat completions API that supports JSON-schema structured
# outputs. Leave LLM_BASE_URL empty for OpenAI. Examples:
#   OpenAI: LLM_BASE_URL=                                LLM_MODEL=gpt-5-nano
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-nano

# --- Production -----------------------------------------------------------------
# Domain served by Caddy with automatic HTTPS (infra/docker-compose.prod.yml).
APP_DOMAIN=planning.example.com
# Password of the production Postgres user (infra/docker-compose.prod.yml).
POSTGRES_PASSWORD=change-me

# --- Hotel -----------------------------------------------------------------------
# Time zone used for "today", the current month and displayed timestamps.
APP_TIMEZONE=Europe/Paris
# Name printed on the monthly PDF sheet.
HOTEL_NAME=Demo Alpine Lodge

# --- Solver (OR-Tools) ---------------------------------------------------------
# Schedule generator service. docker-compose.yml publishes it on localhost:8000;
# the production compose file points web to http://solver:8000.
SOLVER_URL=http://localhost:8000

# --- Visitor quotas --------------------------------------------------------------
# Visitors enter without an account as a manager, an employee or read-only; the
# data is restored every night to rolling demo months. These limits protect the
# solver and the LLM provider.
DEMO_GENERATIONS_PER_HOUR=3
DEMO_LLM_PER_DAY=10
DEMO_LLM_GLOBAL_PER_DAY=100

# --- Jobs -------------------------------------------------------------------
# The pg-boss worker (constraint parsing) runs inside the Next.js server.
# Set to true to disable it, e.g. when running several web replicas.
DISABLE_JOB_WORKER=false
